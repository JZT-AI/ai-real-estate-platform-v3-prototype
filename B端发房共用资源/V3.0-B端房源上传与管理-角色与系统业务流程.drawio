 x="20" y="532" width="1680" height="142" as="geometry" /></mxCell><mxCell id="9" value="AI房地产数据平台&lt;br&gt;系统 · 采集、生产、湖仓消费" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#dce3ed;fontSize=15;fontStyle=1;align=left;spacingLeft=18;" vertex="1" parent="8"><mxGeometry x="0" y="0" width="190" height="142" as="geometry" /></mxCell><mxCell id="10" value="" style="swimlane;horizontal=1;startSize=0;container=1;collapsible=0;fillColor=#ffffff;strokeColor=#dce3ed;" vertex="1" parent="1"><mxGeometry x="20" y="674" width="1680" height="142" as="geometry" /></mxCell><mxCell id="11" value="平台运营&lt;br&gt;角色 · 数据平台后台" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#dce3ed;fontSize=15;fontStyle=1;align=left;spacingLeft=18;" vertex="1" parent="10"><mxGeometry x="0" y="0" width="190" height="142" as="geometry" /></mxCell><mxCell id="12" value="" style="swimlane;horizontal=1;startSize=0;container=1;collapsible=0;fillColor=#f8fafc;strokeColor=#dce3ed;" vertex="1" parent="1"><mxGeometry x="20" y="816" width="1680" height="142" as="geometry" /></mxCell><mxCell id="13" value="微信（外部应用）&lt;br&gt;系统 · 指定企微好友资料页" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#dce3ed;fontSize=15;fontStyle=1;align=left;spacingLeft=18;" vertex="1" parent="12"><mxGeometry x="0" y="0" width="190" height="142" as="geometry" /></mxCell><mxCell id="14" value="悬浮上传／无结果引导&lt;br&gt;粘贴一条或多条链接&lt;br&gt;上传不自动发客户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#a8bde8;fontColor=#24364c;fontSize=14;spacing=8;" vertex="1" parent="2"><mxGeometry x="205" y="42" width="180" height="78" as="geometry" /></mxCell><mxCell id="15" value="按统一规则校验输入&lt;br&gt;提交原文＋本人B端账号&lt;br&gt;查看原上传任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b7c4d5;fontColor=#24364c;fontSize=14;spacing=8;" vertex="1" parent="4"><mxGeometry x="407" y="42" width="180" height="78" as="geometry" /></mxCell><mxCell id="16" value="校验目标账号传房资格&lt;br&gt;按套协调